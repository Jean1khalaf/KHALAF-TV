{
  "name": "khalaf-tv",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "desktop:dev": "electron desktop/main.cjs",
    "desktop:build": "electron-builder --win nsis"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "hls.js": "^1.6.13",
    "lucide-react": "^0.468.0",
    "next": "^15.5.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ably": "^2.10.0",
    "qrcode.react": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "typescript": "^5.8.3",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.khalaftv.desktop",
    "productName": "KHALAF TV",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "main": "desktop/main.cjs"
}
